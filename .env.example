# ============================================================
# CodeArena - Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# ------------------------------------------------------------
# DATABASE (PostgreSQL)
# ------------------------------------------------------------
DATABASE_URL=postgresql://codearena:codearena@localhost:5432/codearena
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=30000

# ------------------------------------------------------------
# API (FastAPI)
# ------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# JWT — generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_TO_64_CHAR_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# ------------------------------------------------------------
# IPC QUEUE (POSIX Shared Memory)
# ------------------------------------------------------------
QUEUE_NAME=/codearena_queue
QUEUE_CAPACITY=1024
QUEUE_SHM_PATH=/dev/shm/codearena_queue
QUEUE_MAGIC=0xC0DEA2EA

# Worker health file
HEALTH_SHM_PATH=/dev/shm/codearena_health

# ------------------------------------------------------------
# SANDBOX
# ------------------------------------------------------------
CGROUP_ROOT=/sys/fs/cgroup/codearena
SANDBOX_TMP_ROOT=/tmp/codearena
SANDBOX_ROOTFS=/opt/codearena/rootfs

# ------------------------------------------------------------
# WORKER POOL
# ------------------------------------------------------------
WORKER_COUNT=4
JOB_LEASE_TIMEOUT_SECONDS=60
MAX_RETRY_COUNT=3
HEARTBEAT_INTERVAL_SECONDS=5

# ------------------------------------------------------------
# RESOURCE LIMITS (defaults, per-problem overrides in DB)
# ------------------------------------------------------------
DEFAULT_TIME_LIMIT_MS=2000
DEFAULT_MEMORY_LIMIT_MB=256
DEFAULT_OUTPUT_LIMIT_KB=64
DEFAULT_PIDS_LIMIT=64
DEFAULT_FILE_SIZE_LIMIT_MB=1
DEFAULT_CPU_QUOTA_PERCENT=100

# ------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ------------------------------------------------------------
# WATCHDOG
# ------------------------------------------------------------
WATCHDOG_INTERVAL_SECONDS=5
STALE_JOB_THRESHOLD_SECONDS=60
CGROUP_CLEANUP_AGE_SECONDS=300
TEMP_CLEANUP_AGE_SECONDS=300